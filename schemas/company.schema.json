  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "commercial_profile": {
      "additionalProperties": true,
      "title": "Commercial Profile",
      "type": "object"
    },
    "company_id": {
      "minLength": 3,
      "title": "Company Id",
      "type": "string"
    },
    "competitive_landscape": {
      "additionalProperties": true,
      "title": "Competitive Landscape",
      "type": "object"
    },
    "data_quality": {
      "$ref": "#/$defs/DataQuality"
    },
    "founded_year": {
      "anyOf": [
        {
          "maximum": 2100,
          "minimum": 1900,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Founded Year"
    },
    "funding_profile": {
      "additionalProperties": true,
      "title": "Funding Profile",
      "type": "object"
    },
    "hq": {
      "$ref": "#/$defs/Headquarters"
    },
    "investor_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Investor Summary"
    },
    "legal_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Legal Name"
    },
    "market_profile": {
      "additionalProperties": true,
      "title": "Market Profile",
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "one_line_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "One Line Summary"
    },
    "primary_category": {
      "title": "Primary Category",
      "type": "string"
    },
    "problem_statement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Problem Statement"
    },
    "product_profile": {
      "$ref": "#/$defs/ProductProfile"
    },
    "relevance_to_qualcomm_or_strategics": {
      "additionalProperties": true,
      "title": "Relevance To Qualcomm Or Strategics",
      "type": "object"
    },
    "secondary_categories": {
      "items": {
        "type": "string"
      },
      "title": "Secondary Categories",
      "type": "array"
    },
    "solution_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solution Summary"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "enum": [
        "private",
        "public",
        "acquired",
        "shutdown",
        "stealth",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    },
    "strategic_scoring": {
      "$ref": "#/$defs/ScoreSet"
    },
    "team_profile": {
      "additionalProperties": true,
      "title": "Team Profile",
      "type": "object"
    },
    "technical_profile": {
      "$ref": "#/$defs/TechnicalProfile"
    },
    "technology_tags": {
      "items": {
        "type": "string"
      },
      "title": "Technology Tags",
      "type": "array"
    },
    "vc_investment_view": {
      "additionalProperties": true,
      "title": "Vc Investment View",
      "type": "object"
    },
    "website": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Website"
    }
  },
  "required": [
    "company_id",
    "name",
    "status",
    "hq",
    "primary_category",
    "product_profile",
    "technical_profile",
    "market_profile",
    "commercial_profile",
    "funding_profile",
    "team_profile",
    "competitive_landscape",
    "vc_investment_view",
    "strategic_scoring",
    "relevance_to_qualcomm_or_strategics",
    "data_quality"
  ],
  "title": "Company",
  "type": "object"
