            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Competitive Intensity"
        },
        "customer_pull": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer Pull"
