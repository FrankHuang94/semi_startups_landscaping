        "product_status": {
          "default": "unknown",
          "enum": [
            "concept",
            "research",
            "announced",
            "sampling",
            "shipping",
            "deployed",
            "discontinued",
            "unknown"
          ],
          "title": "Product Status",
          "type": "string"
